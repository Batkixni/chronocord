# ==============================================================================
# Chronocord - Environment Configuration Template
# Copy this file to .env and fill in your credentials before running.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Discord Bot Credentials (Required)
# Obtain these from: https://discord.com/developers/applications
# ------------------------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# ------------------------------------------------------------------------------
# 2. Database Connection (Required)
# Standard PostgreSQL URL. Works with local Postgres, Docker, Supabase, or Neon.
# For local docker-compose: postgresql://chronocord:chronocord_secret@postgres:5432/chronocord
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/chronocord
DATABASE_SSL=false
DB_POOL_MAX=20

# ------------------------------------------------------------------------------
# 3. Web Dashboard & OAuth2 Configuration (Required)
# The public URL where the web dashboard will be accessed.
# Must match your Discord Developer Portal OAuth2 Redirect URI:
#   <WEB_BASE_URL>/auth/discord/callback
# ------------------------------------------------------------------------------
WEB_BASE_URL=http://localhost:3001
PORT=3001
COOKIE_SECRET=replace_with_a_secure_random_string_for_cookie_signing

# ------------------------------------------------------------------------------
# 4. Email Notification Service (Optional / Recommended)
# Supports OpenMail API for zero-config transactional email delivery.
# If omitted, Discord channel and DM reminders will still operate normally.
# ------------------------------------------------------------------------------
OPENMAIL_API_KEY=
OPENMAIL_FROM_EMAIL=notifications@example.com
OPENMAIL_INBOX_ID=

# ------------------------------------------------------------------------------
# 5. Localization & System Settings
# ------------------------------------------------------------------------------
TZ=UTC
